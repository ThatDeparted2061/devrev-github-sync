# Real deployment: copy to .env and fill in.
DATABASE_URL=postgres://localhost:5432/devrev_sync?sslmode=disable

GITHUB_REPO=your-org/your-repo
GITHUB_API=https://api.github.com
GITHUB_TOKEN=                 # fine-grained PAT: Issues read/write, Pull requests read/write
GITHUB_WEBHOOK_SECRET=        # the secret set on the repo webhook (events: Issues, Pull requests)

DEVREV_API=https://api.devrev.ai
DEVREV_TOKEN=                 # PAT or service account token with work read/write
DEVREV_PART_ID=               # applies_to_part for new issues, e.g. don:core:dvrv-us-1:devo/0:product/1
DEVREV_OWNER_ID=              # owned_by for new issues, e.g. don:identity:dvrv-us-1:devo/0:devu/1
DEVREV_WEBHOOK_SECRET=        # returned once by webhooks.create (event types: work_created, work_updated)

WORKERS=16
MAX_ATTEMPTS=8                # then the event goes to the dead-letter queue (GET /dlq, POST /dlq/replay)
RECONCILE_EVERY=5m
PORT=8090
